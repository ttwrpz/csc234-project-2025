rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);

      // Update is owner-only with one field-level guard:
      // `insightsDisclaimerAcked` is ONE-WAY (false → true). Once a
      // user has acknowledged the bipolar/medical disclaimer (spec §4
      // / ADR-0010), the client cannot revert the ack. The field is
      // optional on the doc — `get(field, false)` provides a safe
      // default so docs predating this field still update freely as
      // long as no client tries to write a `true → false` transition.
      // Admin SDK paths (e.g. account deletion in S5) bypass these
      // rules and remain free to reset the field if a re-ack flow is
      // ever needed.
      allow update: if isOwner(uid)
        && (
          // Was previously not acked (or absent) → any new state OK.
          resource.data.get('insightsDisclaimerAcked', false) == false
          // Was acked → must stay acked.
          || request.resource.data.get('insightsDisclaimerAcked', false) == true
        );

      // Delete preserved from the prior catch-all `write` permission.
      // Account deletion goes through the admin SDK in S5 (ADR-0009),
      // but closing the door on client-side delete now would be a
      // breaking change for any existing flow that relies on it.
      allow delete: if isOwner(uid);

      match /moods/{moodId} {
        allow create: if isOwner(uid)
          && request.resource.data.createdAt == request.time
          && request.resource.data.intensity is int
          && request.resource.data.intensity >= 1
          && request.resource.data.intensity <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.mood in ['happy','calm','okay','sad','angry','anxious'];

        allow read: if isOwner(uid);

        // Edits and deletes are allowed only on the same UTC calendar
        // day as `createdAt`. (Firestore rules don't expose a local-time
        // helper, so the boundary is UTC midnight here; the client uses
        // local-midnight in `MoodEntry.isLocked` — close enough given
        // the user is in Asia/Bangkok with no DST and writes use
        // server-side `request.time` for `createdAt`.)
        allow update: if isOwner(uid)
          && request.time.year() == resource.data.createdAt.year()
          && request.time.month() == resource.data.createdAt.month()
          && request.time.day() == resource.data.createdAt.day()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['mood','intensity','text','mediaRefs','updatedAt'])
          && request.resource.data.intensity is int
          && request.resource.data.intensity >= 1
          && request.resource.data.intensity <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.mood in ['happy','calm','okay','sad','angry','anxious'];

        allow delete: if isOwner(uid)
          && request.time.year() == resource.data.createdAt.year()
          && request.time.month() == resource.data.createdAt.month()
          && request.time.day() == resource.data.createdAt.day();
      }

      match /insights/{insightId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false; // Cloud Function admin SDK only — S4
      }

      // Per-user cheer-up audit log (HB-003 §5.5b). Append-only —
      // every doc is a single trigger event for the
      // `sendCheerUpPush` Cloud Function. Doc id is
      // `${dayUtc}-${reason}` so the trigger can decode the (day,
      // reason) tuple without trusting payload fields, AND so two
      // same-day re-evaluations collapse on the id (the second
      // create fails with `already-exists`, the client treats that
      // as the idempotent path).
      match /cheerUpEvents/{evtId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && evtId.matches('^\\d{4}-\\d{2}-\\d{2}-(5_of_7_negative|3_consecutive_high_intensity)$')
          && request.resource.data.createdAt == request.time
          && request.resource.data.dayUtc is string
          && request.resource.data.dayUtc.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.reason in ['5_of_7_negative','3_consecutive_high_intensity']
          && request.resource.data.schemaV == 1
          && request.resource.data.keys().hasOnly(
              ['reason','dayUtc','createdAt','schemaV']);

        // Append-only audit log: client cannot mutate or delete an
        // emitted event. Account-deletion paths use the admin SDK.
        allow update, delete: if false;
      }

      // Per-user cheer-up cooldown / escalation anchors (HB-003 §5.5a,
      // ADR-0008). Single doc per user (`docId == 'current'`) carrying
      // `lastTriggeredAt` (48h cooldown gate) and `firstTriggeredAt`
      // (10-day escalation window). Field-level validation via
      // diff().affectedKeys() restricts updates to the canonical schema.
      match /interventionState/{docId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && docId == 'current'
          && request.resource.data.schemaV == 1
          && request.resource.data.keys().hasOnly(
              ['lastTriggeredAt','firstTriggeredAt','schemaV']);

        // Update affectedKeys explicitly excludes `schemaV` so the field
        // is immutable post-creation. PR #35 audit R-001: prior allowlist
        // included schemaV without a type guard, which let a buggy or
        // malicious client overwrite it with arbitrary values. Today's
        // CF doesn't read schemaV on this collection, but the moment it
        // does the schema-version invariant must hold. Drop it here
        // rather than add a type guard — the value is set on create and
        // only changes via a deliberate migration (which would land in
        // a Cloud Function under admin SDK, bypassing this rule).
        allow update: if isOwner(uid)
          && docId == 'current'
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastTriggeredAt','firstTriggeredAt'])
          && (request.resource.data.lastTriggeredAt is timestamp
              || request.resource.data.lastTriggeredAt == null)
          && (request.resource.data.firstTriggeredAt is timestamp
              || request.resource.data.firstTriggeredAt == null);

        allow delete: if false;
      }

      // Per-user notification preferences (WBS 6.3, HB-003; extended
      // S5 Day 2 per HB-007 with three per-tier opt-out flags).
      // One doc per user at users/{uid}/settings/notifications carrying
      // the cheer-up shim, the three tier toggles, and the FCM token
      // fan-out list. Field-level validation via diff().affectedKeys()
      // restricts updates to the canonical schema; Cloud Function reads
      // use the admin SDK.
      //
      // Migration write path: `set(merge: true)` from
      // NotificationsFirestoreDatasource may carry all four bool flags
      // at once (one-time repair for legacy docs that only had
      // `cheerUpEnabled`). The rule below accepts the four-flag schema
      // on both create and update; legacy doc-shapes are no longer
      // writable so the migration is forward-only.
      match /settings/{settingId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && settingId == 'notifications'
          && request.resource.data.cheerUpEnabled is bool
          && request.resource.data.tier1Enabled is bool
          && request.resource.data.tier2Enabled is bool
          && request.resource.data.tier3Enabled is bool
          && request.resource.data.tokens is list
          && request.resource.data.tokens.size() <= 25
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly(
              ['cheerUpEnabled','tier1Enabled','tier2Enabled',
               'tier3Enabled','tokens','updatedAt']);

        allow update: if isOwner(uid)
          && settingId == 'notifications'
          && request.resource.data.cheerUpEnabled is bool
          && request.resource.data.tier1Enabled is bool
          && request.resource.data.tier2Enabled is bool
          && request.resource.data.tier3Enabled is bool
          && request.resource.data.tokens is list
          && request.resource.data.tokens.size() <= 25
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['cheerUpEnabled','tier1Enabled','tier2Enabled',
                       'tier3Enabled','tokens','updatedAt']);

        // Notification preferences are never deleted from the client —
        // disabling cheer-up reminders mutates the doc instead. Account
        // deletion (WBS 2.4) uses the admin SDK.
        allow delete: if false;
      }

      // Per-user Pattern Engine result, one doc per local-midnight day
      // (ADR-0011, HB-006 §"Sub-track D"). The 5-algorithm engine
      // (Mann-Kendall, sliding 5-of-7, 3-consecutive S<=-0.6, Z-score,
      // CUSUM) writes one of these per mood log; same-day re-evaluation
      // overwrites the doc cleanly. Mood text is NEVER part of the
      // schema — affectedKeys().hasOnly() enforces it.
      match /patterns/{dateId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.dateId == dateId
          && request.resource.data.schemaV == 1
          && request.resource.data.keys().hasOnly(
              ['dateId','mannKendallZ','slidingNegCount',
               'consecutiveHighIntensity','zScoreToday',
               'cusumC','triggeredTier','schemaV'])
          && (request.resource.data.triggeredTier == null
              || request.resource.data.triggeredTier in ['one','two','three'])
          && (request.resource.data.mannKendallZ == null
              || request.resource.data.mannKendallZ is number)
          && (request.resource.data.zScoreToday == null
              || request.resource.data.zScoreToday is number)
          && request.resource.data.slidingNegCount is int
          && request.resource.data.slidingNegCount >= 0
          && request.resource.data.slidingNegCount <= 7
          && request.resource.data.consecutiveHighIntensity is int
          && request.resource.data.consecutiveHighIntensity >= 0
          && request.resource.data.cusumC is number
          && request.resource.data.cusumC >= 0;

        // Same-day re-evaluation: overwrite is allowed (the engine
        // re-runs on every mood log within the day). The same field
        // allowlist + value guards apply.
        allow update: if isOwner(uid)
          && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.dateId == dateId
          && request.resource.data.schemaV == 1
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['mannKendallZ','slidingNegCount',
                       'consecutiveHighIntensity','zScoreToday',
                       'cusumC','triggeredTier'])
          && (request.resource.data.triggeredTier == null
              || request.resource.data.triggeredTier in ['one','two','three'])
          && (request.resource.data.mannKendallZ == null
              || request.resource.data.mannKendallZ is number)
          && (request.resource.data.zScoreToday == null
              || request.resource.data.zScoreToday is number)
          && request.resource.data.slidingNegCount is int
          && request.resource.data.slidingNegCount >= 0
          && request.resource.data.slidingNegCount <= 7
          && request.resource.data.consecutiveHighIntensity is int
          && request.resource.data.consecutiveHighIntensity >= 0
          && request.resource.data.cusumC is number
          && request.resource.data.cusumC >= 0;

        allow delete: if false;
      }

      // Per-user intervention audit log (HB-007, ADR-0012).
      // Append-only: every doc is one dispatched intervention with a
      // server-time `dispatchedAt`. Same-day re-dispatches collapse on
      // the deterministic id `${tier}-${epochMs}` (the second create
      // fails with `already-exists`, which the repository impl treats
      // as the idempotent path).
      //
      // Update is restricted to a SINGLE one-way transition:
      // `optedOut: false → true` (TC-34 "I'm okay" tap). Every other
      // field is immutable post-create — Tier 3 audit invariant per
      // ADR-0012. Delete is denied; account-deletion paths use the
      // admin SDK.
      match /interventions/{id} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.dispatchedAt == request.time
          && request.resource.data.tier in ['one','two','three']
          && request.resource.data.quoteId is string
          && request.resource.data.quoteId.size() <= 128
          && request.resource.data.cooldownUntil is timestamp
          && request.resource.data.cooldownUntil > request.time
          && (request.resource.data.get('optedOut', false) == false)
          && request.resource.data.schemaV == 1
          && request.resource.data.keys().hasOnly(
              ['dispatchId','tier','dispatchedAt','quoteId',
               'cooldownUntil','optedOut','schemaV']);

        // One-way opt-out toggle. The only diff allowed is
        // `optedOut: false → true`. Tier / dispatchedAt / quoteId /
        // cooldownUntil / schemaV are all immutable.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['optedOut'])
          && resource.data.get('optedOut', false) == false
          && request.resource.data.optedOut == true;

        allow delete: if false;
      }

      // Per-tier (or global) cooldown doc — HB-007 OQ-B default is
      // global ("one anchor across all tiers"). Doc id is the cooldown
      // `type` ('global' for v1; future per-tier values like 'tier_three'
      // remain reachable without rule churn). `lastDispatchedAt` and
      // `cooldownUntil` are the only mutable fields; both must be a
      // server timestamp at or after `request.time`.
      match /cooldowns/{type} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && type.matches('^[a-z_]{1,32}$')
          && request.resource.data.lastDispatchedAt == request.time
          && request.resource.data.cooldownUntil is timestamp
          && request.resource.data.cooldownUntil > request.time
          && request.resource.data.keys().hasOnly(
              ['lastDispatchedAt','cooldownUntil']);

        allow update: if isOwner(uid)
          && type.matches('^[a-z_]{1,32}$')
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastDispatchedAt','cooldownUntil'])
          && request.resource.data.lastDispatchedAt == request.time
          && request.resource.data.cooldownUntil is timestamp
          && request.resource.data.cooldownUntil > request.time;

        allow delete: if false;
      }

      // Per-user PIN hash for the History privacy gate (ADR-0013
      // Decision E §3). One sub-doc at users/{uid}/security/pin
      // holding the PBKDF2-SHA-256 output plus the rate-limit anchor.
      // Verification is client-side; this rule's job is to
      //   1. confine read/write to the owner,
      //   2. enforce the field allow-list so no extra keys land,
      //   3. enforce the algorithm + iteration-count lower bound, and
      //   4. block reads when `lockedUntil > request.time` so a
      //      tampered client cannot bypass the rate limit by skipping
      //      the failure-write.
      //
      // Delete is denied — PIN reset is a "re-set" (write a fresh
      // hash on top), not a one-tap delete. See ADR-0013 §"Reset
      // flow (v1.5)" and the data layer's PinRepositoryImpl.remove()
      // which writes an unrecoverable random hash to "remove."
      //
      // TODO(security-reviewer): final audit before tag — confirm
      // the field allow-list matches the data layer's write, confirm
      // the iterations lower bound matches the hasher's constant
      // (PinHasher.minIterations), and exercise the lockedUntil read
      // gate with the emulator.
      match /security/{docId} {
        function pinAllowedKeys() {
          return ['algorithm','iterations','saltBase64','hashBase64',
                  'createdAt','failedAttempts','lockedUntil'];
        }

        function pinShapeValid() {
          return docId == 'pin'
            && request.resource.data.algorithm == 'pbkdf2-sha256'
            && request.resource.data.iterations is int
            && request.resource.data.iterations >= 100000
            && request.resource.data.saltBase64 is string
            && request.resource.data.hashBase64 is string
            && request.resource.data.createdAt is timestamp
            && request.resource.data.failedAttempts is int
            && request.resource.data.failedAttempts >= 0
            && (request.resource.data.lockedUntil == null
                || request.resource.data.lockedUntil is timestamp)
            && request.resource.data.keys().hasOnly(pinAllowedKeys());
        }

        // Read gate: owner only, AND the rate-limit lockout is over.
        // The `get('lockedUntil', null)` guard tolerates the
        // first-time-no-lock-set state without failing the rule.
        allow read: if isOwner(uid)
          && docId == 'pin'
          && (resource.data.get('lockedUntil', null) == null
              || request.time >= resource.data.lockedUntil);

        // Create (first-time setup) — same shape constraints as
        // update; the doc is `set()` from the client so the same rule
        // covers both paths.
        allow create: if isOwner(uid) && pinShapeValid();

        // Update (re-setup, rotate, rate-limit-anchor bump). The
        // field allow-list is the same — no auxiliary fields land
        // outside the canonical schema.
        allow update: if isOwner(uid) && pinShapeValid();

        // Delete denied — see header comment.
        allow delete: if false;
      }

      // Per-user WebAuthn credential (ADR-0014 Decision C). One doc per
      // registered credential at users/{uid}/webauthn/{credentialId};
      // v1.5 ships single-credential, so the collection holds at most
      // one entry. The client UI reads the doc directly to render the
      // "Security key registered May 15, last used May 17" status tile
      // without a CF round-trip; ALL writes (counter bump, lastUsedAt,
      // failedAttempts, lockedUntil) come through the admin SDK from
      // webauthnRegisterFinish / webauthnAssertionFinish.
      //
      // The read is gated by the rate-limit lockout — a tampered client
      // cannot bypass the per-credential lock by skipping the failure
      // write because the read itself fails when lockedUntil > now.
      // Mirrors the PIN block's pattern at the lockedUntil gate.
      match /webauthn/{credentialId} {
        allow read: if isOwner(uid)
          && (resource.data.get('lockedUntil', null) == null
              || request.time >= resource.data.lockedUntil);
        // Writes by Admin SDK only — CF surface owns these docs.
        allow create, update, delete: if false;
      }

      // Per-user in-flight WebAuthn challenges (ADR-0014 Decision C).
      // 5-minute TTL; CF surface owns the docs end-to-end. The client
      // never reads or writes them — webauthnRegisterStart /
      // webauthnAssertionStart return the challenge in the response
      // payload; webauthn*Finish reads + deletes via admin SDK.
      match /webauthnChallenges/{challengeId} {
        allow read, write: if false;
      }

      // Weekly Harvest archive (HB-005 Track 6.1; ADR-0010 §6).
      // Write-once-on-archive: history is a record, not a redo. Each
      // doc id is the ISO-8601 weekId formatted `YYYY-Www`; the
      // archive use case writes the doc exactly once at the end of
      // each weekly cycle.
      //
      // Bug fix (v1.0 polish, 2026-05-10): the prior rule omission
      // surfaced as a 403 on `BatchGetDocuments` from the History tab
      // and the dev-mode "Force harvest now" button — Firestore
      // denies-by-default when no match block is present. Adding the
      // rule unblocks both the read-side stream
      // (`weeklyGardenHistoryProvider`) and the create-side write.
      //
      // Schema-level validation is deliberately permissive (only
      // weekId match + write-once + server-timestamp on archivedAt)
      // because the entity is rich (entries[], healthHistory[],
      // summary nested object) and a strict allowlist would block
      // legitimate v1.x schema additions. The use case + the unit
      // tests own shape correctness.
      match /weeklyGardens/{weekId} {
        allow read: if isOwner(uid);

        // archivedAt arrives as an ISO-8601 string (json_serializable's
        // default DateTime serializer) — Firestore does NOT auto-convert
        // unless the client passes a literal `Timestamp` or
        // `FieldValue.serverTimestamp()`. The validation here is
        // therefore string-shape; the use case + the unit tests own
        // the value's correctness (must be `now` per spec §6).
        allow create: if isOwner(uid)
          && weekId.matches('^\\d{4}-W\\d{2}$')
          && request.resource.data.weekId == weekId
          && request.resource.data.archivedAt is string;

        // Update + delete denied: the archive is immutable. A second
        // archive attempt for the same week surfaces as 'already-
        // exists' on create; the repository impl maps that to
        // HarvestFailure.alreadyArchived.
        allow update, delete: if false;
      }
    }

    match /rateLimits/{uid} {
      allow read, write: if false; // admin SDK only
    }
  }
}
