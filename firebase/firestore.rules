rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /moods/{moodId} {
        allow create: if isOwner(uid)
          && request.resource.data.createdAt == request.time
          && request.resource.data.intensity is int
          && request.resource.data.intensity >= 1
          && request.resource.data.intensity <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.mood in ['happy','calm','okay','sad','angry','anxious'];

        allow read: if isOwner(uid);

        // Edits and deletes are allowed only on the same UTC calendar
        // day as `createdAt`. (Firestore rules don't expose a local-time
        // helper, so the boundary is UTC midnight here; the client uses
        // local-midnight in `MoodEntry.isLocked` — close enough given
        // the user is in Asia/Bangkok with no DST and writes use
        // server-side `request.time` for `createdAt`.)
        allow update: if isOwner(uid)
          && request.time.year() == resource.data.createdAt.year()
          && request.time.month() == resource.data.createdAt.month()
          && request.time.day() == resource.data.createdAt.day()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['mood','intensity','text','mediaRefs','updatedAt'])
          && request.resource.data.intensity is int
          && request.resource.data.intensity >= 1
          && request.resource.data.intensity <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.mood in ['happy','calm','okay','sad','angry','anxious'];

        allow delete: if isOwner(uid)
          && request.time.year() == resource.data.createdAt.year()
          && request.time.month() == resource.data.createdAt.month()
          && request.time.day() == resource.data.createdAt.day();
      }

      match /insights/{insightId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false; // Cloud Function admin SDK only — S4
      }

      // Per-user cheer-up audit log (HB-003 §5.5b). Append-only —
      // every doc is a single trigger event for the
      // `sendCheerUpPush` Cloud Function. Doc id is
      // `${dayUtc}-${reason}` so the trigger can decode the (day,
      // reason) tuple without trusting payload fields, AND so two
      // same-day re-evaluations collapse on the id (the second
      // create fails with `already-exists`, the client treats that
      // as the idempotent path).
      match /cheerUpEvents/{evtId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && evtId.matches('^\\d{4}-\\d{2}-\\d{2}-(5_of_7_negative|3_consecutive_high_intensity)$')
          && request.resource.data.createdAt == request.time
          && request.resource.data.dayUtc is string
          && request.resource.data.dayUtc.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.reason in ['5_of_7_negative','3_consecutive_high_intensity']
          && request.resource.data.schemaV == 1
          && request.resource.data.keys().hasOnly(
              ['reason','dayUtc','createdAt','schemaV']);

        // Append-only audit log: client cannot mutate or delete an
        // emitted event. Account-deletion paths use the admin SDK.
        allow update, delete: if false;
      }

      // Per-user cheer-up cooldown / escalation anchors (HB-003 §5.5a,
      // ADR-0008). Single doc per user (`docId == 'current'`) carrying
      // `lastTriggeredAt` (48h cooldown gate) and `firstTriggeredAt`
      // (10-day escalation window). Field-level validation via
      // diff().affectedKeys() restricts updates to the canonical schema.
      match /interventionState/{docId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && docId == 'current'
          && request.resource.data.schemaV == 1
          && request.resource.data.keys().hasOnly(
              ['lastTriggeredAt','firstTriggeredAt','schemaV']);

        allow update: if isOwner(uid)
          && docId == 'current'
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastTriggeredAt','firstTriggeredAt','schemaV'])
          && (request.resource.data.lastTriggeredAt is timestamp
              || request.resource.data.lastTriggeredAt == null)
          && (request.resource.data.firstTriggeredAt is timestamp
              || request.resource.data.firstTriggeredAt == null);

        allow delete: if false;
      }

      // Per-user notification preferences (WBS 6.3, HB-003).
      // One doc per user at users/{uid}/settings/notifications carrying
      // the cheer-up toggle and the FCM token fan-out list. Field-level
      // validation via diff().affectedKeys() restricts updates to the
      // canonical schema; Cloud Function reads use the admin SDK.
      match /settings/{settingId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && settingId == 'notifications'
          && request.resource.data.cheerUpEnabled is bool
          && request.resource.data.tokens is list
          && request.resource.data.tokens.size() <= 25
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly(
              ['cheerUpEnabled','tokens','updatedAt']);

        allow update: if isOwner(uid)
          && settingId == 'notifications'
          && request.resource.data.cheerUpEnabled is bool
          && request.resource.data.tokens is list
          && request.resource.data.tokens.size() <= 25
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['cheerUpEnabled','tokens','updatedAt']);

        // Notification preferences are never deleted from the client —
        // disabling cheer-up reminders mutates the doc instead. Account
        // deletion (WBS 2.4) uses the admin SDK.
        allow delete: if false;
      }
    }

    match /rateLimits/{uid} {
      allow read, write: if false; // admin SDK only
    }
  }
}
